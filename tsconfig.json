{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "../sdk/src": ["./sdk/src/index.ts"]
    }
  },
  "include": ["agents/**/*"],
  "exclude": ["node_modules", "dist", "contract", "sdk/dist"]
}
